generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum SeasonStatus {
  PLANNED
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum ManagerStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum ManagerSeasonStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum ManagerParticipationStatus {
  ACTIVE
  PAUSED
  WITHDRAWN
}

enum ManagerTransferStatus {
  NOT_STARTED
  OPEN
  SUBMITTED
  LOCKED
}

enum ManagerSeasonLifecycleStatus {
  CREATED
  REGISTERED
  ACTIVE
  COMPLETED
}

enum UserRole {
  ADMIN
  DATA_MAINTAINER
  MANAGER
}

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum LeagueLevel {
  FIRST
  SECOND
}

enum TeamStatus {
  VALID
  INVALID
  PAUSED
}

enum CompetitionType {
  LEAGUE_1
  LEAGUE_2
  CUP
  EUROPE
  SUPERCUP
}

enum CompetitionStatus {
  PLANNED
  ACTIVE
  COMPLETED
}

enum PositionGroup {
  TW
  AB
  MF
  ST
}

enum PlayerStatus {
  ACTIVE
  LEFT_BUNDESLIGA
  INACTIVE
}

enum PlayerListVersionStatus {
  PREVIEWED
  APPLIED
  SUPERSEDED
}

enum SquadAssignmentReason {
  INITIAL_SQUAD
  SUMMER_TRANSFER
  WINTER_TRANSFER
  REAL_TRANSFER_REPLACEMENT
  ADMIN_CORRECTION
}

enum FixtureStatus {
  SCHEDULED
  CALCULATED
  OFFICIAL
  CANCELLED
}

enum PlayerMatchDataSource {
  KICKER
  ADMIN
}

enum MatchResultStatus {
  CALCULATED
  OFFICIAL
}

enum AppliedRuleType {
  TEAM_INVALID
  TEAM_PENALTY
  POINT_ADJUSTMENT
  MATCH_OVERRIDE
  ADMIN_NOTE
}

enum ManualMatchdayAdjustmentType {
  INVALID_TEAM
  TEAM_PENALTY
  POINT_ADJUSTMENT
  BONUS
  OTHER
}

enum ManualMatchdayAdjustmentStatus {
  ACTIVE
  VOIDED
}

enum TransferPhaseType {
  SUMMER
  WINTER
}

enum TransferPhaseStatus {
  PLANNED
  OPEN
  CLOSED
  LOCKED
}

enum TransferSubmissionStatus {
  DRAFT
  SUBMITTED
  ACCEPTED
  REJECTED
}

enum PlayerDepartureBatchStatus {
  DRAFT
  RELEASED
  VOIDED
}

enum PlayerDepartureEventStatus {
  DRAFT
  ACTIVE
  VOIDED
}

enum ManagerMandatoryTransferStatus {
  OPEN
  COMPLETED
  VOIDED
}

enum PlayerMasterChangeBatchStatus {
  DRAFT
  RELEASED
  VOIDED
}

enum PlayerMasterChangeStatus {
  DRAFT
  ACTIVE
  VOIDED
}

enum PlayerMasterChangeType {
  STATUS_CHANGE
  CLUB_CHANGE
  POSITION_CHANGE
  MARKET_VALUE_CHANGE
}

enum MatchdayLifecycleStatus {
  DRAFT
  DATA_ENTRY_OPEN
  DATA_ENTERED
  DATA_ENTRY_COMPLETE
  CALCULATED
  PRELIMINARY_PUBLISHED
  PUBLISHED_PRELIMINARY
  MANUAL_REVIEW_CONFIRMED
  CORRECTIONS_CONFIRMED
  OFFICIALLY_CLOSED
  REOPENED
  PUBLISHED_OFFICIAL
  ARCHIVED
}

enum CompetitionLifecycleStatus {
  CREATED
  PARTICIPANTS_CONFIRMED
  FIXTURE_GENERATED
  READY
  ACTIVE
  COMPLETED
  DRAW_REQUIRED
  ROUND_READY
  PARTICIPANTS_REQUIRED
  LEAGUE_PHASE_READY
  KNOCKOUT_READY
  FIXTURE_READY
}

model Season {
  id                        String                     @id @default(auto()) @map("_id") @db.ObjectId
  name                      String
  yearStart                 Int
  yearEnd                   Int
  status                    SeasonStatus
  teams                     Team[]
  managerSeasons            ManagerSeason[]
  competitions              Competition[]
  playerMatchData           PlayerMatchData[]
  playerMatchDataImports    PlayerMatchDataImportAudit[]
  transferPhases            TransferPhase[]
  matchdays                 MatchdayLifecycle[]
  playerListVersions        PlayerListVersion[]
  manualMatchdayAdjustments ManualMatchdayAdjustment[]
  playerDepartureBatches    PlayerDepartureBatch[]
  playerMasterChangeBatches PlayerMasterChangeBatch[]

  @@unique([yearStart, yearEnd])
  @@index([status])
}

model Manager {
  id             String          @id @default(auto()) @map("_id") @db.ObjectId
  displayName    String
  shortName      String
  status         ManagerStatus
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  teams          Team[]
  managerSeasons ManagerSeason[]
  user           User?

  @@unique([shortName])
  @@index([status])
}

model User {
  id          String     @id @default(auto()) @map("_id") @db.ObjectId
  email       String
  displayName String
  role        UserRole
  status      UserStatus
  managerId   String?    @unique @db.ObjectId
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  manager     Manager?   @relation(fields: [managerId], references: [id])

  @@unique([email])
  @@index([role, status])
}

model ManagerSeason {
  id                        String                       @id @default(auto()) @map("_id") @db.ObjectId
  managerId                 String                       @db.ObjectId
  seasonId                  String                       @db.ObjectId
  league                    LeagueLevel
  budget                    Float
  status                    ManagerSeasonStatus
  participation             ManagerParticipationStatus
  transferStatus            ManagerTransferStatus
  currentLifecycle          ManagerSeasonLifecycleStatus
  createdAt                 DateTime                     @default(now())
  updatedAt                 DateTime                     @updatedAt
  manager                   Manager                      @relation(fields: [managerId], references: [id])
  season                    Season                       @relation(fields: [seasonId], references: [id])
  squadAssignments          SquadAssignment[]
  manualMatchdayAdjustments ManualMatchdayAdjustment[]
  mandatoryTransfers        ManagerMandatoryTransfer[]

  @@unique([seasonId, managerId])
  @@index([seasonId, league])
  @@index([status, participation])
}

model SquadImportAudit {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  importedAt       DateTime @default(now())
  seasonId         String   @db.ObjectId
  workbookName     String
  workbookPath     String?
  importedManagers Int
  importedSlots    Int
  warningsJson     Json
  durationMs       Int
  summaryJson      Json

  @@index([seasonId, importedAt])
}

model ManagerImportAudit {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  importedAt     DateTime @default(now())
  seasonId       String   @db.ObjectId
  workbookName   String
  workbookPath   String?
  newManagers    Int
  existing       Int
  leagueChanges  Int
  budgetChanges  Int
  pausedManagers Int
  errors         Int
  durationMs     Int
  summaryJson    Json

  @@index([seasonId, importedAt])
}

model Team {
  id               String               @id @default(auto()) @map("_id") @db.ObjectId
  seasonId         String               @db.ObjectId
  managerId        String               @db.ObjectId
  name             String
  leagueLevel      LeagueLevel
  status           TeamStatus
  season           Season               @relation(fields: [seasonId], references: [id])
  manager          Manager              @relation(fields: [managerId], references: [id])
  squadAssignments SquadAssignment[]
  homeFixtures     Fixture[]            @relation("HomeTeamFixtures")
  awayFixtures     Fixture[]            @relation("AwayTeamFixtures")
  appliedRules     AppliedRule[]
  submissions      TransferSubmission[]

  @@unique([seasonId, managerId])
  @@index([seasonId, leagueLevel])
  @@index([status])
}

model Competition {
  id                        String                     @id @default(auto()) @map("_id") @db.ObjectId
  seasonId                  String                     @db.ObjectId
  type                      CompetitionType
  name                      String
  status                    CompetitionStatus
  season                    Season                     @relation(fields: [seasonId], references: [id])
  lifecycle                 CompetitionLifecycle?
  fixtures                  Fixture[]
  tableSnapshots            LeagueTableSnapshot[]
  appliedRules              AppliedRule[]
  matchdays                 MatchdayLifecycle[]
  versions                  MatchdayVersion[]
  manualMatchdayAdjustments ManualMatchdayAdjustment[]
  playerMatchDataImports    PlayerMatchDataImportAudit[]

  @@unique([seasonId, type, name])
  @@index([seasonId, status])
}

model CompetitionLifecycle {
  id                    String                     @id @default(auto()) @map("_id") @db.ObjectId
  competitionId         String                     @unique @db.ObjectId
  status                CompetitionLifecycleStatus
  progressPercent       Int
  availableActionsJson  Json
  completedActionsJson  Json
  nextRecommendedAction String?
  timelineEntriesJson   Json
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  competition           Competition                @relation(fields: [competitionId], references: [id])

  @@index([status])
}

model Player {
  id                 String                     @id @default(auto()) @map("_id") @db.ObjectId
  kickerId           String?
  firstName          String?
  lastName           String?
  displayName        String
  positionGroup      PositionGroup
  bundesligaClub     String
  marketValue        Float
  status             PlayerStatus
  squadAssignments   SquadAssignment[]
  matchData          PlayerMatchData[]
  departureEvents    PlayerDepartureEvent[]
  mandatoryTransfers ManagerMandatoryTransfer[]
  masterChanges      PlayerMasterChange[]

  @@unique([displayName])
  @@index([kickerId])
  @@index([positionGroup, status])
  @@index([bundesligaClub])
}

model PlayerImportAudit {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  importedAt   DateTime @default(now())
  workbookName String
  workbookPath String?
  imported     Int
  updated      Int
  unchanged    Int
  departures   Int
  errors       Int
  durationMs   Int
  summaryJson  Json

  @@index([importedAt])
}

model PlayerListVersion {
  id                 String                  @id @default(auto()) @map("_id") @db.ObjectId
  seasonId           String                  @db.ObjectId
  phase              TransferPhaseType
  versionNumber      Int
  status             PlayerListVersionStatus
  filename           String
  importedAt         DateTime                @default(now())
  appliedAt          DateTime?
  countsJson         Json
  ignoredColumnsJson Json
  deltaJson          Json
  note               String?
  createdBy          String?
  season             Season                  @relation(fields: [seasonId], references: [id])

  @@unique([seasonId, phase, versionNumber])
  @@index([seasonId, phase, status])
  @@index([importedAt])
}

model PlayerMasterChangeBatch {
  id                    String                        @id @default(auto()) @map("_id") @db.ObjectId
  seasonId              String                        @db.ObjectId
  status                PlayerMasterChangeBatchStatus
  createdAt             DateTime                      @default(now())
  releasedAt            DateTime?
  effectiveFromMatchday Int?
  note                  String?
  season                Season                        @relation(fields: [seasonId], references: [id])
  changes               PlayerMasterChange[]

  @@index([seasonId, status, createdAt])
}

model PlayerMasterChange {
  id                 String                   @id @default(auto()) @map("_id") @db.ObjectId
  batchId            String                   @db.ObjectId
  playerId           String                   @db.ObjectId
  type               PlayerMasterChangeType
  oldStatus          PlayerStatus?
  newStatus          PlayerStatus?
  oldClub            String?
  newClub            String?
  oldPositionGroup   PositionGroup?
  newPositionGroup   PositionGroup?
  oldMarketValue     Float?
  newMarketValue     Float?
  reason             String
  status             PlayerMasterChangeStatus
  impactWarningsJson Json?
  createdAt          DateTime                 @default(now())
  releasedAt         DateTime?
  batch              PlayerMasterChangeBatch  @relation(fields: [batchId], references: [id])
  player             Player                   @relation(fields: [playerId], references: [id])

  @@index([batchId, status])
  @@index([playerId, status])
  @@index([type, status])
}

model SquadAssignment {
  id                String                @id @default(auto()) @map("_id") @db.ObjectId
  teamId            String?               @db.ObjectId
  managerSeasonId   String?               @db.ObjectId
  playerId          String                @db.ObjectId
  slotId            Int
  validFromMatchday Int
  validToMatchday   Int?
  reason            SquadAssignmentReason
  createdAt         DateTime              @default(now())
  team              Team?                 @relation(fields: [teamId], references: [id])
  managerSeason     ManagerSeason?        @relation(fields: [managerSeasonId], references: [id])
  player            Player                @relation(fields: [playerId], references: [id])

  @@unique([managerSeasonId, slotId, validFromMatchday])
  @@index([managerSeasonId, slotId, validFromMatchday, validToMatchday])
  @@index([teamId, slotId, validFromMatchday, validToMatchday])
  @@index([playerId, validFromMatchday, validToMatchday])
}

model PlayerDepartureBatch {
  id                    String                     @id @default(auto()) @map("_id") @db.ObjectId
  seasonId              String                     @db.ObjectId
  phaseLabel            String?
  status                PlayerDepartureBatchStatus
  createdAt             DateTime                   @default(now())
  releasedAt            DateTime?
  effectiveFromMatchday Int?
  note                  String?
  season                Season                     @relation(fields: [seasonId], references: [id])
  events                PlayerDepartureEvent[]

  @@index([seasonId, status, createdAt])
}

model PlayerDepartureEvent {
  id                 String                     @id @default(auto()) @map("_id") @db.ObjectId
  batchId            String                     @db.ObjectId
  playerId           String                     @db.ObjectId
  reason             String
  status             PlayerDepartureEventStatus
  createdAt          DateTime                   @default(now())
  releasedAt         DateTime?
  batch              PlayerDepartureBatch       @relation(fields: [batchId], references: [id])
  player             Player                     @relation(fields: [playerId], references: [id])
  mandatoryTransfers ManagerMandatoryTransfer[]

  @@index([batchId, status])
  @@index([playerId, status])
}

model ManagerMandatoryTransfer {
  id                     String                         @id @default(auto()) @map("_id") @db.ObjectId
  managerSeasonId        String                         @db.ObjectId
  playerDepartureEventId String                         @db.ObjectId
  outgoingPlayerId       String                         @db.ObjectId
  positionGroup          PositionGroup
  slotId                 Int
  effectiveFromMatchday  Int
  status                 ManagerMandatoryTransferStatus
  createdAt              DateTime                       @default(now())
  completedAt            DateTime?
  managerSeason          ManagerSeason                  @relation(fields: [managerSeasonId], references: [id])
  playerDepartureEvent   PlayerDepartureEvent           @relation(fields: [playerDepartureEventId], references: [id])
  outgoingPlayer         Player                         @relation(fields: [outgoingPlayerId], references: [id])

  @@unique([managerSeasonId, playerDepartureEventId, slotId])
  @@index([managerSeasonId, status, effectiveFromMatchday])
  @@index([outgoingPlayerId, status])
}

model Fixture {
  id            String        @id @default(auto()) @map("_id") @db.ObjectId
  competitionId String        @db.ObjectId
  matchday      Int
  round         String?
  phase         String?
  homeTeamId    String        @db.ObjectId
  awayTeamId    String        @db.ObjectId
  status        FixtureStatus
  competition   Competition   @relation(fields: [competitionId], references: [id])
  homeTeam      Team          @relation("HomeTeamFixtures", fields: [homeTeamId], references: [id])
  awayTeam      Team          @relation("AwayTeamFixtures", fields: [awayTeamId], references: [id])
  result        MatchResult?
  appliedRules  AppliedRule[]

  @@unique([competitionId, matchday, homeTeamId, awayTeamId])
  @@index([competitionId, matchday, status])
  @@index([homeTeamId, matchday])
  @@index([awayTeamId, matchday])
}

model PlayerMatchData {
  id            String                @id @default(auto()) @map("_id") @db.ObjectId
  seasonId      String                @db.ObjectId
  matchday      Int
  playerId      String                @db.ObjectId
  rating        Float?
  goals         Int                   @default(0)
  yellowRed     Boolean               @default(false)
  red           Boolean               @default(false)
  teamOfTheWeek Boolean               @default(false)
  source        PlayerMatchDataSource
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  season        Season                @relation(fields: [seasonId], references: [id])
  player        Player                @relation(fields: [playerId], references: [id])

  @@unique([seasonId, matchday, playerId])
  @@index([playerId, seasonId, matchday])
}

model PlayerMatchDataImportAudit {
  id             String      @id @default(auto()) @map("_id") @db.ObjectId
  seasonId       String      @db.ObjectId
  competitionId  String      @db.ObjectId
  matchday       Int
  filename       String
  importedRows   Int
  updatedRows    Int
  unchangedRows  Int
  conflictRows   Int
  unknownRows    Int
  importedAt     DateTime    @default(now())
  summaryJson    Json
  season         Season      @relation(fields: [seasonId], references: [id])
  competition    Competition @relation(fields: [competitionId], references: [id])

  @@index([seasonId, competitionId, matchday, importedAt])
}

model MatchResult {
  id                  String            @id @default(auto()) @map("_id") @db.ObjectId
  fixtureId           String            @unique @db.ObjectId
  calculatedHomeGoals Int
  calculatedAwayGoals Int
  officialHomeGoals   Int
  officialAwayGoals   Int
  status              MatchResultStatus
  auditJson           Json?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  fixture             Fixture           @relation(fields: [fixtureId], references: [id])

  @@index([status])
}

model ManualMatchdayAdjustment {
  id              String                         @id @default(auto()) @map("_id") @db.ObjectId
  seasonId        String                         @db.ObjectId
  competitionId   String                         @db.ObjectId
  matchday        Int
  managerSeasonId String                         @db.ObjectId
  type            ManualMatchdayAdjustmentType
  points          Int
  reason          String
  createdAt       DateTime                       @default(now())
  createdBy       String?
  status          ManualMatchdayAdjustmentStatus
  season          Season                         @relation(fields: [seasonId], references: [id])
  competition     Competition                    @relation(fields: [competitionId], references: [id])
  managerSeason   ManagerSeason                  @relation(fields: [managerSeasonId], references: [id])

  @@index([competitionId, matchday, status])
  @@index([managerSeasonId, matchday])
}

model LeagueTableSnapshot {
  id            String      @id @default(auto()) @map("_id") @db.ObjectId
  competitionId String      @db.ObjectId
  matchday      Int
  tableJson     Json
  createdAt     DateTime    @default(now())
  competition   Competition @relation(fields: [competitionId], references: [id])

  @@unique([competitionId, matchday])
}

model AppliedRule {
  id            String          @id @default(auto()) @map("_id") @db.ObjectId
  fixtureId     String?         @db.ObjectId
  teamId        String?         @db.ObjectId
  competitionId String          @db.ObjectId
  matchday      Int
  type          AppliedRuleType
  valueJson     Json
  reason        String
  createdAt     DateTime        @default(now())
  fixture       Fixture?        @relation(fields: [fixtureId], references: [id])
  team          Team?           @relation(fields: [teamId], references: [id])
  competition   Competition     @relation(fields: [competitionId], references: [id])

  @@index([competitionId, matchday, type])
  @@index([fixtureId])
  @@index([teamId, matchday])
}

model MatchdayLifecycle {
  id                 String                  @id @default(auto()) @map("_id") @db.ObjectId
  seasonId           String                  @db.ObjectId
  competitionId      String                  @db.ObjectId
  matchday           Int
  status             MatchdayLifecycleStatus
  latestVersionId    String?                 @db.ObjectId
  lastCalculationAt  DateTime?
  lastPublishedAt    DateTime?
  correctionPending  Boolean                 @default(false)
  correctionReason   String?
  correctionPlanJson Json?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  season             Season                  @relation(fields: [seasonId], references: [id])
  competition        Competition             @relation(fields: [competitionId], references: [id])
  latestVersion      MatchdayVersion?        @relation("LatestMatchdayVersion", fields: [latestVersionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  versions           MatchdayVersion[]       @relation("MatchdayVersions")

  @@unique([competitionId, matchday])
  @@index([seasonId, competitionId, status])
  @@index([latestVersionId])
}

model MatchdayVersion {
  id                      String                  @id @default(auto()) @map("_id") @db.ObjectId
  lifecycleId             String                  @db.ObjectId
  seasonId                String                  @db.ObjectId
  competitionId           String                  @db.ObjectId
  matchday                Int
  versionNumber           Int
  status                  MatchdayLifecycleStatus
  createdAt               DateTime                @default(now())
  createdBy               String?
  reason                  String?
  calculationSnapshotJson Json?
  officialMatchdayJson    Json?
  publishedAt             DateTime?
  lifecycle               MatchdayLifecycle       @relation("MatchdayVersions", fields: [lifecycleId], references: [id])
  visibleForLifecycles    MatchdayLifecycle[]     @relation("LatestMatchdayVersion")
  competition             Competition             @relation(fields: [competitionId], references: [id])

  @@unique([competitionId, matchday, versionNumber])
  @@index([lifecycleId, versionNumber])
  @@index([seasonId, competitionId, matchday, status])
}

model TransferPhase {
  id          String               @id @default(auto()) @map("_id") @db.ObjectId
  seasonId    String               @db.ObjectId
  type        TransferPhaseType
  status      TransferPhaseStatus
  opensAt     DateTime?
  deadlineAt  DateTime?
  season      Season               @relation(fields: [seasonId], references: [id])
  submissions TransferSubmission[]

  @@unique([seasonId, type])
  @@index([status, opensAt, deadlineAt])
}

model TransferSubmission {
  id              String                   @id @default(auto()) @map("_id") @db.ObjectId
  transferPhaseId String                   @db.ObjectId
  teamId          String                   @db.ObjectId
  status          TransferSubmissionStatus
  submittedAt     DateTime?
  budgetJson      Json
  transfersJson   Json
  validationJson  Json
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  transferPhase   TransferPhase            @relation(fields: [transferPhaseId], references: [id])
  team            Team                     @relation(fields: [teamId], references: [id])

  @@unique([transferPhaseId, teamId])
  @@index([teamId, status])
}
